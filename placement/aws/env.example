# Account-specific settings for the EC2 scripts. This experiment (placement) shares the
# file with the spark-scale experiment: ~/.config/vdi-spark/env. If it already exists,
# there is nothing to do. Otherwise copy this there and fill it in (mode 600).
#
# The file lives outside every repo on purpose (worktrees don't share untracked files;
# artifact syncs copy whole directories). Nothing here is a credential, but none of it
# belongs in a public repo. The pre-commit hook in git-hooks/ refuses any commit that
# contains one of the values marked (guarded).

VDI_AWS_ACCOUNT_ID=123456789012            # (guarded) aws sts get-caller-identity
VDI_AWS_ORG_ID=o-xxxxxxxxxx                # (guarded) aws organizations describe-organization
VDI_VPC_ID=vpc-xxxxxxxx                    # (guarded) default VPC in the region
VDI_AWS_REGION=us-east-2

# The results bucket is named after the account, so it is guarded too
VDI_RESULTS_BUCKET=vdi-spark-scale-results-${VDI_AWS_ACCOUNT_ID}
VDI_DATA_BUCKET_TPCH=vod-tpch-1tb
VDI_DATA_BUCKET_TPCDS=vod-tpcds-1tb

VDI_KEY_PAIR_NAME=vdi-spark
VDI_SSH_KEY=$HOME/.ssh/vdi-spark

# spark-scale's selector tag. The placement scripts IGNORE these two and always use
# project=vdi-placement (env.sh); they must never be set to vdi-placement.
VDI_TAG_KEY=project
VDI_TAG_VALUE=vdi-spark-scale
