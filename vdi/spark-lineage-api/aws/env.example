# Account-specific settings for the EC2 scale-up scripts.
#
# Copy to ~/.config/vdi-spark/env and fill in. That file lives outside every repo on
# purpose: git worktrees don't share untracked files, and the artifact sync into
# value-of-data-indicator/vdi/ copies directories wholesale, so a gitignored file
# inside the tree would still leak. See SECRETS.md.
#
# Nothing here is a credential, but none of it belongs in a public repo.
# Scripts load it through env.sh; the pre-commit hook in git-hooks/ refuses any
# commit that contains one of the values marked (guarded).

VDI_AWS_ACCOUNT_ID=123456789012            # (guarded) aws sts get-caller-identity
VDI_AWS_ORG_ID=o-xxxxxxxxxx                # (guarded) aws organizations describe-organization
VDI_VPC_ID=vpc-xxxxxxxx                    # (guarded) default VPC in the region
VDI_AWS_REGION=us-east-2

# The template names the results bucket after the account, so it is guarded too
VDI_RESULTS_BUCKET=vdi-spark-scale-results-${VDI_AWS_ACCOUNT_ID}
VDI_DATA_BUCKET_TPCH=vod-tpch-1tb
VDI_DATA_BUCKET_TPCDS=vod-tpcds-1tb

VDI_KEY_PAIR_NAME=vdi-spark
VDI_SSH_KEY=$HOME/.ssh/vdi-spark
VDI_TAG_KEY=project
VDI_TAG_VALUE=vdi-spark-scale
